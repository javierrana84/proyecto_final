apiVersion: apps/v1
kind: Deployment
metadata:
  name: flight-status
  namespace: ${namespace}
  labels:
    app.kubernetes.io/name: flight-status
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: flight-status
  template:
    metadata:
      labels:
        app.kubernetes.io/name: flight-status
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: app
          image: ${app_image}
          imagePullPolicy: ${image_pull_policy}
          ports:
            - name: http
              containerPort: 8080
          env:
            - name: APP_VERSION
              value: "1.0.0"
            - name: AIRLABS_API_KEY
              valueFrom:
                secretKeyRef:
                  name: flight-api
                  key: api-key
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
            readOnlyRootFilesystem: true
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 256Mi
          startupProbe:
            httpGet:
              path: /health
              port: http
            periodSeconds: 5
            failureThreshold: 12
          livenessProbe:
            httpGet:
              path: /health
              port: http
            periodSeconds: 20
          readinessProbe:
            httpGet:
              path: /ready
              port: http
            periodSeconds: 10
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}