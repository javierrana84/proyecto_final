apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: flight-status
  namespace: ${namespace}
  annotations:
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
spec:
  ingressClassName: nginx
  rules:
    - host: flight.local
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: flight-status
                port:
                  number: 80